{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nineties-country-showdown",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "games.murphsmitts.com/*",
      "zone_name": "murphsmitts.com"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "workers_dev": true,
  "preview_urls": true
}
